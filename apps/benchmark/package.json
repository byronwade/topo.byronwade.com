{
  "name": "@topo/benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "benchmark": "node dist/cli.js",
    "capture:performance": "node dist/capture-performance-cli.js",
    "web:performance": "node dist/web-performance-cli.js",
    "studio:loading": "node dist/studio-loading-cli.js",
    "studio:boards": "node dist/studio-board-cli.js",
    "studio:profiles": "node dist/studio-profile-cli.js",
    "system:performance": "node dist/system-performance-cli.js --cli-entry ../../packages/cli/dist/index.js --output ../../artifacts/benchmarks/performance-system.json",
    "local:runtime": "node dist/local-runtime-cli.js",
    "framework:fixtures": "node dist/framework-fixtures-cli.js",
    "storybook:capture": "node dist/storybook-cli.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@topo/application-runtime": "workspace:*",
    "@topo/adapter-api-source": "workspace:*",
    "@topo/adapter-next": "workspace:*",
    "@topo/adapter-nuxt": "workspace:*",
    "@topo/adapter-openapi": "workspace:*",
    "@topo/adapter-react": "workspace:*",
    "@topo/adapter-svelte": "workspace:*",
    "@topo/adapter-tanstack": "workspace:*",
    "@topo/adapter-storybook": "workspace:*",
    "@topo/adapter-vue": "workspace:*",
    "@topo/canvas-engine": "workspace:*",
    "@topo/config": "workspace:*",
    "@topo/daemon": "workspace:*",
    "@topo/framework-adapter": "workspace:*",
    "@topo/endpoint-adapter": "workspace:*",
    "@topo/flow-adapter": "workspace:*",
    "@topo/adapter-flow-source": "workspace:*",
    "@topo/gateway": "workspace:*",
    "@topo/graph": "workspace:*",
    "@topo/layout": "workspace:*",
    "@topo/live-frame-host": "workspace:*",
    "@topo/llm-context": "workspace:*",
    "@topo/local-runtime": "workspace:*",
    "@topo/renderer-pixi": "workspace:*",
    "@topo/scanner": "workspace:*",
    "@topo/schema": "workspace:*",
    "@topo/snapshots": "workspace:*",
    "@topo/studio-host": "workspace:*",
    "@topo/studio-api": "workspace:*",
    "@topo/workspace": "workspace:*",
    "pixi.js": "^8.10.2",
    "playwright": "^1.55.0",
    "vite": "^8.2.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
