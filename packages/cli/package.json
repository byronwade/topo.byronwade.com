{
  "name": "@topo/cli",
  "version": "0.1.0",
  "private": false,
  "description": "Local-first, code-native application atlas and Studio.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byronwade/topo.byronwade.com.git"
  },
  "homepage": "https://topo.byronwade.com",
  "bugs": "https://github.com/byronwade/topo.byronwade.com/issues",
  "keywords": [
    "application-atlas",
    "nextjs",
    "tanstack-router",
    "pixijs",
    "mcp"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "topo": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "pack:check": "node scripts/check-pack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jiti": "^2.4.2",
    "oxc-parser": "0.142.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "vite": "^7.0.6",
    "ws": "^8.21.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@topo/adapter-scaffold": "workspace:*",
    "@topo/application-runtime": "workspace:*",
    "@topo/cache": "workspace:*",
    "@topo/config": "workspace:*",
    "@topo/daemon": "workspace:*",
    "@topo/diagnostics": "workspace:*",
    "@topo/doctor": "workspace:*",
    "@topo/exporter": "workspace:*",
    "@topo/flows": "workspace:*",
    "@topo/gateway": "workspace:*",
    "@topo/initializer": "workspace:*",
    "@topo/llm-context": "workspace:*",
    "@topo/local-runtime": "workspace:*",
    "@topo/mcp": "workspace:*",
    "@topo/notes": "workspace:*",
    "@topo/project-lifecycle": "workspace:*",
    "@topo/protocol": "workspace:*",
    "@topo/snapshots": "workspace:*",
    "@topo/storage": "workspace:*",
    "@topo/studio-host": "workspace:*",
    "@topo/workspace": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  }
}
